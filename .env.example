# Copy to .env; the server loads it on startup. Shell variables override it.
UPLOADS_BUCKET=textract-onboarding-uploads-xx01
AWS_PROFILE=your-aws-profile
AWS_REGION=eu-west-1
# DynamoDB table for batch status (terraform output pipeline_table)
PIPELINE_TABLE=textract-onboarding-pipeline
# Documents bucket, for showing document images (terraform output documents_bucket)
DOCUMENTS_BUCKET=textract-onboarding-documents-xx01

# Optional, shown with their defaults
# PART_SIZE_MB=10
# MAX_UPLOAD_GB=50
# PRESIGN_TTL=15m
# ADDR=:5173
# ALLOWED_ORIGIN=
